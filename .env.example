RAG_MODE=mock
SMALL_MODEL=ollama/llama3.2:3b
LARGE_MODEL=ollama/qwen2.5:7b
JUDGE_MODEL=ollama/qwen2.5:7b
EXTRACT_MODEL=ollama/qwen2.5:7b
OLLAMA_API_BASE=http://localhost:11434
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
QDRANT_URL=http://localhost:6333
# Ignored by mock audit storage; real mode requires PostgreSQL.
DATABASE_URL=postgresql+psycopg://rag:devpassword@localhost:5432/rag
# Paths can be relative to the repository root or absolute Windows/POSIX paths.
RAG_DOCS_DIR=data/docs_sample
RAG_STATE_DB=data/runtime/state.db
RAG_SEED_DIR=data/seed
RAG_AUDIT_DB=data/runtime/audit.db
# Leave empty for a process-local mock signing key; set a random >=32-byte key in real mode.
JWT_SECRET=
JWT_TTL_SECONDS=3600
RAG_REQUESTS_DB=data/runtime/requests.db
CACHE_THRESHOLD=0.90
CACHE_TTL_SECONDS=600
CACHE_GUARD=true
ROUTER_MODE=rule
# Applies only to the standalone public multi-hop pipeline, never authenticated /ask.
RETRIEVAL_MODE=vector
RETRIEVAL_THRESHOLD=0.20
RUN_TAG=api
# Reference USD per million tokens, not charges for local Ollama calls.
REFERENCE_SMALL_INPUT=0.15
REFERENCE_SMALL_OUTPUT=0.60
REFERENCE_LARGE_INPUT=2.50
REFERENCE_LARGE_OUTPUT=10.00
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=devpassword
GRAPH_EXTRACT_CACHE=data/runtime/graph_extract
